/************************************************************
  Proyek Akhir Sistem Mikrokontroler
  Judul  : Sistem Monitoring Suhu dan Kelembaban Ruangan Ujian
  Board  : ESP32 DevKit V1
  Sensor : DHT22
  IoT    : Blynk IoT
  Aktuator: LED hijau, LED merah, buzzer alarm

  Ganti BLYNK_TEMPLATE_ID, BLYNK_TEMPLATE_NAME, dan BLYNK_AUTH_TOKEN
  sesuai data dari Blynk Console.
************************************************************/

#define BLYNK_PRINT Serial
#define BLYNK_TEMPLATE_ID "TMPLxxxxxxx"
#define BLYNK_TEMPLATE_NAME "Monitoring Ruang Ujian"
#define BLYNK_AUTH_TOKEN "ISI_AUTH_TOKEN_BLYNK_KAMU"

#include <WiFi.h>
#include <BlynkSimpleEsp32.h>
#include <DHTesp.h>

// WiFi khusus Wokwi
char ssid[] = "Wokwi-GUEST";
char pass[] = "";

// Pin komponen
const int DHT_PIN    = 15;
const int LED_HIJAU  = 26;
const int LED_MERAH  = 27;
const int BUZZER_PIN = 25;

// Ambang batas kondisi ruangan ujian
const float BATAS_SUHU_C    = 30.0;
const float BATAS_KELEMBABAN = 70.0;

DHTesp dhtSensor;
BlynkTimer timer;

bool alarmAktif = true;
bool statusBahayaSebelumnya = false;

// V4 dari Blynk digunakan sebagai tombol ON/OFF alarm
BLYNK_WRITE(V4) {
  alarmAktif = param.asInt();
}

void setAktuator(bool bahaya) {
  digitalWrite(LED_HIJAU, bahaya ? LOW : HIGH);
  digitalWrite(LED_MERAH, bahaya ? HIGH : LOW);

  if (bahaya && alarmAktif) {
    tone(BUZZER_PIN, 1000);   // bunyi alarm
  } else {
    noTone(BUZZER_PIN);
    digitalWrite(BUZZER_PIN, LOW);
  }
}

void bacaDanKirimSensor() {
  TempAndHumidity data = dhtSensor.getTempAndHumidity();

  if (isnan(data.temperature) || isnan(data.humidity)) {
    Serial.println("Gagal membaca sensor DHT22");
    return;
  }

  float suhu = data.temperature;
  float kelembaban = data.humidity;
  bool bahaya = (suhu > BATAS_SUHU_C || kelembaban > BATAS_KELEMBABAN);

  setAktuator(bahaya);

  // Kirim data ke Blynk Dashboard
  Blynk.virtualWrite(V0, suhu);
  Blynk.virtualWrite(V1, kelembaban);
  Blynk.virtualWrite(V2, bahaya ? 1 : 0);
  Blynk.virtualWrite(V3, (bahaya && alarmAktif) ? 1 : 0);
  Blynk.virtualWrite(V5, bahaya ? "TIDAK AMAN" : "AMAN");

  // Opsional: aktifkan jika sudah membuat Event di Blynk dengan event code: ruang_ujian_alert
  // Agar tidak spam, notifikasi hanya dikirim saat status berubah dari AMAN ke TIDAK AMAN.
  if (bahaya && !statusBahayaSebelumnya) {
    // Blynk.logEvent("ruang_ujian_alert", "Suhu/kelembaban ruangan ujian melewati batas aman");
  }
  statusBahayaSebelumnya = bahaya;

  Serial.print("Suhu: ");
  Serial.print(suhu, 1);
  Serial.print(" C | Kelembaban: ");
  Serial.print(kelembaban, 1);
  Serial.print(" % | Status: ");
  Serial.println(bahaya ? "TIDAK AMAN" : "AMAN");
}

void setup() {
  Serial.begin(115200);

  pinMode(LED_HIJAU, OUTPUT);
  pinMode(LED_MERAH, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  digitalWrite(LED_HIJAU, LOW);
  digitalWrite(LED_MERAH, LOW);
  digitalWrite(BUZZER_PIN, LOW);

  dhtSensor.setup(DHT_PIN, DHTesp::DHT22);

  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);
  timer.setInterval(2000L, bacaDanKirimSensor); // kirim data setiap 2 detik
}

void loop() {
  Blynk.run();
  timer.run();
}
